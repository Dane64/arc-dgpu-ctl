#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/arc-dgpu-ctl PREFIX=/usr \
	    SYSTEMDUNITDIR=/usr/lib/systemd/system \
	    UDEVRULESDIR=/usr/lib/udev/rules.d

# Enabled, never started: the unit only acts after the user ran
# `arc-dgpu-ctl off` (saved state "off"), so enabling it changes nothing on
# its own.
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade

override_dh_auto_test:
	$(MAKE) test
